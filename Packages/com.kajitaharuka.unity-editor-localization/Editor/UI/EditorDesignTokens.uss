/* UnityEditorLocalization の Editor UI 用デザイントークン＋再利用コンポーネントスタイル。
   色はスキンクラス（eui-dark / eui-light）配下のトークンとして定義し、Unity 内部の
   --unity-* 変数には依存しない（バージョン更新に強い）。間隔・フォント・角丸はスキン
   非依存のトークンとして eui-root に定義し、任意の生値ではなく少数のステップだけを
   使う（間隔のリズムを意図的に保つ）。ルート/スキンクラスは EditorL10nUiKit.ApplyTheme
   がコード側から付与する。USS は名前で解決される。 */

.eui-dark {
    --eui-card-bg: #3a3a3a;
    --eui-inset-bg: #2c2c2c;
    --eui-border: #232323;
    --eui-text: #d4d4d4;
    --eui-text-muted: #9a9a9a;
    --eui-accent: #7ba7ff;
    --eui-accent-bg: #2e3a55;
    --eui-ok: #79d08a;
    --eui-ok-bg: #26402b;
    --eui-warn: #e6c15c;
    --eui-warn-bg: #43391c;
    --eui-err: #f08c82;
    --eui-err-bg: #4a2725;
}

.eui-light {
    --eui-card-bg: #e6e6e6;
    --eui-inset-bg: #d8d8d8;
    --eui-border: #b6b6b6;
    --eui-text: #1f1f1f;
    --eui-text-muted: #5a5a5a;
    --eui-accent: #2c5fd0;
    --eui-accent-bg: #d2def7;
    --eui-ok: #256a2c;
    --eui-ok-bg: #cde6cf;
    --eui-warn: #8a6d10;
    --eui-warn-bg: #f0e4bf;
    --eui-err: #b23026;
    --eui-err-bg: #f2d4d0;
}

/* スキン非依存のトークン（間隔・フォント・角丸）。
   フォントは 11/12/13 の 3 段のみ（太さと合わせて階層を作る。段を増やさない）。
   間隔は 2/4/6/8/12 のステップのみを使う。 */
.eui-root {
    --eui-space-xs: 2px;
    --eui-space-s: 4px;
    --eui-space-m: 6px;
    --eui-space-l: 8px;
    --eui-space-xl: 12px;
    --eui-font-s: 11px;
    --eui-font-m: 12px;
    --eui-font-l: 13px;
    --eui-radius-s: 3px;
    --eui-radius-m: 4px;
    --eui-radius-l: 6px;

    /* 描画領域の端に内容が張り付かないよう、画面全体に外周の余白を与える（端に padding を取る）。 */
    padding-top: var(--eui-space-m);
    padding-right: var(--eui-space-xl);
    padding-bottom: var(--eui-space-l);
    padding-left: var(--eui-space-l);
}

/* ===== ヘッダー（2 ゾーン: 左=アイデンティティ, 右=汎用chrome）===== */
.eui-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--eui-space-l);
}

.eui-header__texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.eui-header__title-row {
    flex-direction: row;
    align-items: center;
}

.eui-header__title {
    -unity-font-style: bold;
    font-size: var(--eui-font-l);
    color: var(--eui-text);
    flex-shrink: 1;
}

.eui-header__title-row .eui-badge {
    margin-left: var(--eui-space-l);
    flex-shrink: 0;
}

.eui-header__subtitle {
    font-size: var(--eui-font-s);
    color: var(--eui-text-muted);
    white-space: normal;
    margin-top: var(--eui-space-xs);
}

.eui-header__actions {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: var(--eui-space-l);
}

/* アイコンのみのリンク/メタ操作ボタン（汎用chrome）。枠・背景なし、ホバーで背景。
   組み込みアイコン（_Help 等）はスキン別画像が返るため tint しない。 */
.eui-icon-link {
    width: 22px;
    height: 22px;
    padding: 1px;
    margin: 0 0 0 var(--eui-space-s);
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--eui-radius-m);
}

.eui-icon-link:hover {
    background-color: var(--eui-inset-bg);
}

.eui-icon-link__icon {
    width: 16px;
    height: 16px;
}

/* ===== セクションカード ===== */
.eui-section {
    background-color: var(--eui-card-bg);
    border-width: 1px;
    border-color: var(--eui-border);
    border-radius: var(--eui-radius-l);
    padding: var(--eui-space-l) 10px;
    margin-bottom: var(--eui-space-l);
}

/* セクション見出し。中身（scope 名 12px）に負けない大きさ・本文色で「道標」として立てる。
   色は使わない（色は状態のために取っておく）。 */
.eui-section__title {
    -unity-font-style: bold;
    font-size: var(--eui-font-m);
    color: var(--eui-text);
    white-space: normal;
    margin-bottom: var(--eui-space-m);
}

/* 折りたたみセクションの見出し行（チェブロン＋タイトル＋要約スロット）。
   行全体がクリックで開閉できるため、ホバーで背景を出してクリック可能を示す。 */
.eui-section__head {
    flex-direction: row;
    align-items: center;
    border-radius: var(--eui-radius-m);
    padding: var(--eui-space-xs) var(--eui-space-s);
    margin-bottom: var(--eui-space-s);
}

.eui-section__head:hover {
    background-color: var(--eui-inset-bg);
}

/* head 行内ではタイトルの下余白は行側が持つ（align-items:center のズレを避ける）。 */
.eui-section__head > .eui-section__title {
    margin-bottom: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* 畳んだままでも概況が分かる要約スロット（ピル等を置く）。 */
.eui-section__summary {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.eui-section__summary .eui-badge {
    margin-left: var(--eui-space-s);
}

/* 展開トグル（チェブロン）。折りたたみ可能と一目で分かる大きさのグリフにしつつ、色は
   控えめ・ホバーで背景。Button なのでキーボード操作可。 */
.eui-chevron {
    width: 20px;
    height: 20px;
    padding: 0;
    margin: 0 var(--eui-space-s) 0 0;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--eui-radius-s);
    color: var(--eui-text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.eui-chevron:hover {
    color: var(--eui-text);
    background-color: var(--eui-card-bg);
}

/* 段落の補足ノート（永続表示の説明文。認識>想起・説明性） */
.eui-note {
    color: var(--eui-text-muted);
    font-size: var(--eui-font-s);
    white-space: normal;
    margin-bottom: var(--eui-space-m);
}

/* 入力欄補足の常時ヒント行 */
.eui-hint {
    color: var(--eui-text-muted);
    font-size: var(--eui-font-s);
    white-space: normal;
    margin-top: var(--eui-space-xs);
    margin-bottom: var(--eui-space-xs);
}

.eui-separator {
    height: 1px;
    background-color: var(--eui-border);
    margin-top: var(--eui-space-m);
    margin-bottom: var(--eui-space-s);
}

/* 「Powered by UnityEditorLocalization」クレジット（任意・控えめなリンク調）。枠/背景なし、ホバーで強調。
   利用側ツールのフッター等にも置かれる要素なので、意図的に最小サイズ（10px）のまま据え置く。 */
.eui-attribution {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--eui-radius-s);
    padding: 1px var(--eui-space-s);
    margin: var(--eui-space-xs) 0 0 0;
    color: var(--eui-text-muted);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.eui-attribution:hover {
    color: var(--eui-accent);
    background-color: var(--eui-inset-bg);
}

/* クリックできるアセット/パス行（選択＋Ping）。長いパスは折り返す */
.eui-asset-row {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--eui-radius-s);
    -unity-text-align: middle-left;
    padding: var(--eui-space-xs) var(--eui-space-s);
    margin: var(--eui-space-xs) 0 0 0;
    color: var(--eui-accent);
    font-size: var(--eui-font-s);
    white-space: normal;
}

.eui-asset-row:hover {
    background-color: var(--eui-inset-bg);
}

/* ===== 状態バッジ / ピル ===== */
.eui-badge {
    border-radius: var(--eui-radius-m);
    padding: 1px 7px;
    font-size: var(--eui-font-s);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.eui-badge--ok { background-color: var(--eui-ok-bg); color: var(--eui-ok); }
.eui-badge--warn { background-color: var(--eui-warn-bg); color: var(--eui-warn); }
.eui-badge--err { background-color: var(--eui-err-bg); color: var(--eui-err); }
.eui-badge--neutral { background-color: var(--eui-inset-bg); color: var(--eui-text-muted); }
.eui-badge--accent { background-color: var(--eui-accent-bg); color: var(--eui-accent); }

/* ===== 操作ボタンの横並び行（カタログの検証/再読み込み、スキルの登録など）===== */
.l10n-catalogs {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--eui-space-l);
}

.l10n-catalogs .unity-button {
    margin: 0 var(--eui-space-m) 0 0;
}

/* 横並び行内で全幅を取り次行へ折り返す結果行（row 専用。列フローでは eui-inline-result を使う）。 */
.l10n-catalogs__result {
    font-size: var(--eui-font-s);
    margin: var(--eui-space-s) 0 0 0;
    white-space: normal;
    flex-basis: 100%;
}

/* 列フロー（column）に直接置く操作結果の 1 行。row 専用の flex-basis:100% を持たない。 */
.eui-inline-result {
    font-size: var(--eui-font-s);
    margin: var(--eui-space-xs) 0 var(--eui-space-m) 0;
    white-space: normal;
}

/* ===== scope 個別設定の各カード ===== */
.l10n-scope-card {
    background-color: var(--eui-inset-bg);
    border-width: 1px;
    border-color: var(--eui-border);
    border-radius: 5px;
    padding: var(--eui-space-m) var(--eui-space-l);
    margin-bottom: var(--eui-space-m);
}

/* head 行はクリックで開閉できる。ホバーで背景を出してクリック可能を示す。 */
.l10n-scope-card__head {
    flex-direction: row;
    align-items: center;
    border-radius: var(--eui-radius-m);
    padding: 1px var(--eui-space-xs);
}

.l10n-scope-card__head:hover {
    background-color: var(--eui-card-bg);
}

/* カード内（inset 背景上）のチェブロンはホバー背景を card 色にして沈ませない。 */
.l10n-scope-card .eui-chevron:hover,
.l10n-vgroup .eui-chevron:hover {
    background-color: var(--eui-card-bg);
}

/* scope 名（長い識別子を折り返す） */
.l10n-scope-card__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--eui-font-m);
    color: var(--eui-text);
}

.l10n-scope-card__pills {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

.l10n-scope-card__pills .eui-badge {
    margin-left: var(--eui-space-s);
}

/* scope の状態メタ行（current / source / default）。淡色・折り返し */
.l10n-scope-meta {
    color: var(--eui-text-muted);
    font-size: var(--eui-font-s);
    white-space: normal;
    margin: var(--eui-space-xs) 0 0 14px;
}

/* fallback/カタログ外の補足。警告色で注意を促す（色だけでなく文言でも伝わる） */
.l10n-scope-meta--warn {
    color: var(--eui-warn);
}

.l10n-scope-body {
    margin: var(--eui-space-s) 0 var(--eui-space-xs) 14px;
}

/* ===== fallback 連鎖の可視化（要求ロケール → 親 → defaultLocale）===== */
/* 各段をチップで横並びにし、実際に翻訳が当たった段を強調する。色だけに頼らず
   太字・配置でも「使用中」が伝わるようにする（アクセシビリティ）。 */
.l10n-scope-chain {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: var(--eui-space-m) 0 0 0;
}

.l10n-scope-chain__label {
    color: var(--eui-text-muted);
    font-size: var(--eui-font-s);
    margin-right: var(--eui-space-s);
}

/* 連鎖の各段（ロケールタグ）。既定は「試したが翻訳なし」の淡色表示。 */
.l10n-chain-step {
    color: var(--eui-text-muted);
    background-color: var(--eui-card-bg);
    border-radius: var(--eui-radius-s);
    padding: 0 5px;
    margin: 1px 0;
    font-size: var(--eui-font-s);
    -unity-text-align: middle-center;
}

/* 実際に翻訳が見つかって表示に使われた段（強調）。 */
.l10n-chain-step--used {
    color: var(--eui-ok);
    background-color: var(--eui-ok-bg);
    -unity-font-style: bold;
}

/* 使用段より後＝探索に到達しない段（さらに淡く）。 */
.l10n-chain-step--skipped {
    opacity: 0.45;
}

/* 段同士の区切り矢印。 */
.l10n-chain-sep {
    color: var(--eui-text-muted);
    font-size: var(--eui-font-s);
    margin: 0 3px;
}

/* ===== カタログの scope 別グループ（ファイル一覧＋検証結果）===== */
/* どの scope のどのファイル・どの警告かを一目で追えるよう、scope ごとに折りたためる
   グループで並べる。見た目は scope カードと同じ語彙に合わせて一貫性を保つ。 */
.l10n-validation-groups {
    margin-top: var(--eui-space-m);
}

/* 1 scope ぶんのグループ（折りたたみ可能）。 */
.l10n-vgroup {
    background-color: var(--eui-inset-bg);
    border-width: 1px;
    border-color: var(--eui-border);
    border-radius: 5px;
    padding: var(--eui-space-s) var(--eui-space-m);
    margin-bottom: var(--eui-space-m);
}

/* head 行はクリックで開閉できる。ホバーで背景を出してクリック可能を示す。 */
.l10n-vgroup__head {
    flex-direction: row;
    align-items: center;
    border-radius: var(--eui-radius-m);
    padding: 1px var(--eui-space-xs);
}

.l10n-vgroup__head:hover {
    background-color: var(--eui-card-bg);
}

/* scope 名（長い識別子を折り返す）。 */
.l10n-vgroup__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--eui-font-m);
    color: var(--eui-text);
}

.l10n-vgroup__body {
    margin: var(--eui-space-s) 0 var(--eui-space-xs) 14px;
}

/* カタログファイル 1 行（locale タグ/既定ピル＋クリックで選択できるパス行＋key 数）。 */
.l10n-file-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.l10n-file-row .eui-badge {
    flex-shrink: 0;
    margin-right: var(--eui-space-s);
}

.l10n-file-row .eui-asset-row {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

/* manifest が宣言しているのにファイルが無いテーブルのパス表示（クリック不可・淡色）。 */
.l10n-file-row__missing {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--eui-font-s);
    color: var(--eui-text-muted);
    padding: var(--eui-space-xs) var(--eui-space-s);
}

/* issue 1 行（深刻度マーカー / locale チップ / メッセージ / 行末のクイックfix）。長文は折り返す。 */
.l10n-vissue {
    flex-direction: row;
    align-items: flex-start;
    margin: var(--eui-space-xs) 0;
    border-radius: var(--eui-radius-s);
    padding: 1px var(--eui-space-xs);
}

/* 由来アセットへジャンプできる行は、ホバーで背景を出してクリック可能を示す。 */
.l10n-vissue--clickable:hover {
    background-color: var(--eui-card-bg);
}

/* 不足キーをその場で追加するクイックfix（"+"）。行末に置き、行頭の深刻度マーカーの
   縦の整列を崩さない（IDE のクイックfix と同じ位置の慣習）。 */
.l10n-vissue__add {
    width: 16px;
    min-width: 16px;
    height: 16px;
    padding: 0;
    margin: 0 0 0 var(--eui-space-s);
    flex-shrink: 0;
    font-size: var(--eui-font-m);
    -unity-text-align: middle-center;
}

/* 深刻度マーカー（× / !）。eui-badge の配色を流用しつつ正方形に寄せる。 */
.l10n-vissue__mark {
    min-width: 16px;
    margin-top: 1px;
    margin-right: var(--eui-space-s);
    flex-shrink: 0;
}

/* locale チップ。inset 背景の上で沈まないよう card 背景で少し浮かせる。 */
.l10n-vissue__locale {
    background-color: var(--eui-card-bg);
    color: var(--eui-text-muted);
    margin-top: 1px;
    margin-right: var(--eui-space-s);
    flex-shrink: 0;
}

.l10n-vissue__msg {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--eui-font-s);
    color: var(--eui-text-muted);
}

/* ===== AIエージェント連携スキル ===== */
/* 同梱スキル 1 件の紹介（名前＋説明）。 */
.l10n-skill {
    margin-bottom: var(--eui-space-s);
}

.l10n-skill__name {
    -unity-font-style: bold;
    font-size: var(--eui-font-s);
    color: var(--eui-text);
}

/* 登録先 1 件の行（登録ボタン＋登録状態ピル）。状態が見えるように隣接させる。 */
.l10n-install-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--eui-space-s);
}

.l10n-install-row .eui-badge {
    margin-left: var(--eui-space-s);
    flex-shrink: 0;
}

/* CLI コマンド表示行（読み取り専用フィールド＋コピー）。 */
.l10n-cli-row {
    flex-direction: row;
    align-items: flex-start;
}

.l10n-cli-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--eui-font-s);
    margin-right: var(--eui-space-s);
}
