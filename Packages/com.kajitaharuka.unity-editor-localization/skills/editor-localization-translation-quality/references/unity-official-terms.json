  "familyTerms": {
    "Target": {
      "ja": {
        "preferred": "対象",
        "avoid": [
          "ターゲット"
        ],
        "why": "指しているのは Build Target のような Unity の固有機能名ではなく「操作の対象」。6 リポジトリ 46 件が 対象 で一貫している（2026-08-26 実測。外れは UEWCE の 2 件だけ）"
      },
      "ko": {
        "preferred": "대상",
        "avoid": [
          "타겟"
        ],
        "why": "ja の 対象 と同じ理由。6 リポジトリすべてが 대상 を使用（2026-08-26 実測）"
      }
    },
    "Default": {
      "ja": {
        "preferred": "既定",
        "avoid": [
          "デフォルト"
        ],
        "why": "日本語 IT 文書の標準表記。6 リポジトリ 22 件が 既定 で一貫（2026-08-26 実測）"
      }
    },
    "Index": {
      "ja": {
        "preferred": "要素番号",
        "avoid": [
          "インデックス"
        ],
        "why": "利用者が数える「何番目か」を指す。配列の添字という実装語を UI に出さない"
      },
      "zh-Hans": {
        "preferred": "序号",
        "avoid": [
          "索引"
        ],
        "why": "ja の 要素番号 と同じ理由。公式訳の 索引 は検索インデックスとも読める"
      }
    },
    "Grid": {
      "ja": {
        "preferred": "格子",
        "avoid": [
          "グリッド"
        ],
        "why": "整列の形を指す普通名詞として使う。Unity の Grid コンポーネント自体を指すときは公式訳の グリッド が正しいので、その場合は例外として読み替える"
      }
    },
    "Play Mode": {
      "ja": {
        "preferred": "Play Mode",
        "avoid": [
          "再生モード",
          "プレイモード"
        ],
        "why": "全 19 ロケールで原語維持と決めた識別子。UI 上の場所を一意に指すため訳さない"
      }
    },
    "Origin": {
      "ja": {
        "preferred": "基準点",
        "avoid": [],
        "why": "原文（ja）が 基準点 で、Unity の Origin フィールドとは別概念。訳は原文に従う。原点 は普通名詞として正当に出うるので avoid には入れない（記録のみ）"
      }
    },
    "Anchor": {
      "ja": {
        "preferred": "基準点の位置",
        "avoid": [],
        "why": "Origin と同じ理由。UI Toolkit の Anchor とは別概念（記録のみ）"
      }
    },
    "Rotation": {
      "ja": {
        "preferred": "回転",
        "avoid": [],
        "why": "回転＝回転量（度）、向き＝どちらを向くか、で使い分ける。同じ画面に両方が出るため統一しない（記録のみ）"
      }
    }
  }
}
